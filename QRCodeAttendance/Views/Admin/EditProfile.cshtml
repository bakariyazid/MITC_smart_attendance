@model QRCodeAttendance.Models.DTOs.Admin.UpdateAdminProfileRequestModel
@using QRCodeAttendance.Models.Enums
@{
    ViewData["Title"] = "Edit Admin Profile";
}

<style>
    /* Page background aligned with QR Code / Digital Attendance theme */
    body {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.85), rgba(17, 94, 89, 0.85)),
            url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?q=80&w=1920&auto=format&fit=crop') no-repeat center center fixed;
        background-size: cover;
        min-height: 100vh;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    /* Glassmorphism Card Container */
    .card {
        background: rgba(255, 255, 255, 0.12) !important;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.25) !important;
        border-radius: 20px !important;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3) !important;
        color: #f8fafc;
    }

    /* Typography & Headers */
    h1.h3 {
        color: #ffffff;
        font-weight: 700;
    }

    .text-muted {
        color: #94a3b8 !important;
    }

    /* Form Labels */
    .form-label {
        font-weight: 600;
        color: #cbd5e1;
        font-size: 0.875rem;
        letter-spacing: 0.02em;
    }

    /* Glass Inputs & Textareas & Selects */
    .form-control,
    .form-select {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
        color: #f8fafc !important;
        border-radius: 12px !important;
        padding: 0.75rem 1rem;
        backdrop-filter: blur(8px);
        transition: all 0.2s ease;
    }

    .form-control:focus,
    .form-select:focus {
        background: rgba(255, 255, 255, 0.15) !important;
        border-color: rgba(13, 148, 136, 0.8) !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 148, 136, 0.25) !important;
        color: #fff !important;
    }

    .form-control::placeholder {
        color: #94a3b8;
    }

    /* Ensure dropdown options remain readable on dark themes */
    .form-select option {
        background: #0f172a;
        color: #f8fafc;
    }

    /* Custom Submit Button */
    .btn-success {
        background: linear-gradient(135deg, #0d9488, #0f766e);
        border: none;
        border-radius: 12px;
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(13, 148, 136, 0.35);
        transition: all 0.2s ease;
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #0f766e, #115e59);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(13, 148, 136, 0.5);
    }

    /* Cancel Button */
    .btn-outline-secondary {
        color: #cbd5e1;
        border-color: rgba(255, 255, 255, 0.3);
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(6px);
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-outline-secondary:hover {
        color: #ffffff;
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.5);
    }
</style>

<main class="container py-5" style="max-width:820px">
    <section class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 mb-1">Edit admin profile</h1>
                    <p class="text-muted mb-0">Keep your administrator contact details current.</p>
                </div>
                <a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
            </div>
            
            <form asp-action="EditProfile" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select"></select>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                </div>
                
                <div class="col-12">
                    <label asp-for="Address" class="form-label"></label>
                    <textarea asp-for="Address" rows="3" class="form-control"></textarea>
                </div>
                
                <div class="col-12 pt-2">
                    <button class="btn btn-success px-4">Save changes</button>
                </div>
            </form>
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}